---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	preloadImage?: string;
	preloadMedia?: string;
}

const {
	title = "Ricardo Gonzalez | Portfolio",
	description = "Portfolio de Ricardo Gonzalez, desarrollador de software.",
	preloadImage,
	preloadMedia,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const siteUrl = "https://davinrtx.github.io/portfolio/";
// En build estatico Astro arma la request URL con new URL(site).origin (sin path)
// + la ruta ya con base. Quitamos el prefijo de base y recomponemos contra siteUrl.
const routePath = Astro.url.pathname.replace(base, "").replace(/^\//, "");
const canonicalUrl = new URL(routePath, siteUrl);
const ogImageUrl = new URL("images/og-card.png", siteUrl);
const ogImageAlt =
	"Tarjeta retro de Ricardo Gonzalez — Tecnico Superior Universitario en Informatica";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={`${base}favicon.svg`} />
		<meta name="theme-color" content="#e9d9b9" />
		{
			preloadImage && (
				<link
					rel="preload"
					as="image"
					href={preloadImage}
					media={preloadMedia}
					fetchpriority="high"
				/>
			)
		}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.href} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl.href} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Ricardo Gonzalez",
			"url": siteUrl,
			"image": "https://davinrtx.github.io/portfolio/images/og-card.png",
			"jobTitle": "Técnico Superior Universitario en Informática",
			"description": description,
			"knowsAbout": ["JavaScript", "TypeScript", "Astro", "Node.js", "SQL", "Python"],
		})} />
		<script is:inline>
			document.documentElement.classList.add("js");

			const navigationEntry = performance.getEntriesByType("navigation")[0];
			const isReload = navigationEntry?.type === "reload";
			const isStartHash = window.location.hash === "#inicio";
			const shouldResetScroll = (isReload && !window.location.hash) || isStartHash;

			if (shouldResetScroll && "scrollRestoration" in history) {
				history.scrollRestoration = "manual";

				window.addEventListener(
					"pageshow",
					() => {
						requestAnimationFrame(() => {
							requestAnimationFrame(() => {
								const previousScrollBehavior =
									document.documentElement.style.scrollBehavior;

								document.documentElement.style.scrollBehavior = "auto";
								window.scrollTo(0, 0);
								document.documentElement.style.scrollBehavior =
									previousScrollBehavior;
								history.scrollRestoration = "auto";
							});
						});
					},
					{ once: true },
				);
			}
		</script>
		<slot name="head" />
	</head>
	<body>
		<slot />

		<script>
			const revealTargets = Array.from(
				document.querySelectorAll<HTMLElement>("[data-reveal]"),
			);
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			const reveal = (element: HTMLElement) => {
				element.dataset.revealed = "";
			};

			if (reducedMotion.matches || !("IntersectionObserver" in window)) {
				revealTargets.forEach(reveal);
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;

							reveal(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						});
					},
					{
						rootMargin: "0px 0px -15% 0px",
						threshold: 0.08,
					},
				);

				revealTargets.forEach((element) => observer.observe(element));
			}
		</script>
	</body>
</html>
