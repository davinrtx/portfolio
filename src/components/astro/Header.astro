---
import "@fontsource-variable/pixelify-sans";
---

<header class="site-header">
	<div class="window-bar" aria-hidden="true">
		<img src="/images/icono_header.webp" alt="" />
		<div class="window-controls">
			<span class="window-control window-control--minimize"></span>
			<span class="window-control window-control--maximize"></span>
			<span class="window-control window-control--close"></span>
		</div>
	</div>

	<div class="header-content">
		<a class="brand" href="#inicio" aria-label="Ir al inicio">
			<img
				class="brand-icon"
				src="/images/icono_header.webp"
				alt="Computadora retro con un símbolo de código en la pantalla"
				width="112"
				height="112"
			/>

			<div class="brand-copy">
				<p class="brand-name">
					<span>DAMIAN</span><span class="brand-name-accent"> ACEVES</span>
				</p>
				<p class="brand-tagline">Código. Soluciones. Resultados. <span aria-hidden="true">☘</span></p>
			</div>
		</a>

		<nav class="main-nav" aria-label="Navegación principal">
			<a class="nav-link is-active" href="#inicio" aria-current="page">
				<img class="nav-icon" src="/header_icons/inicio.webp" alt="" />
				<span>Inicio</span>
			</a>

			<a class="nav-link" href="#proyectos">
				<img class="nav-icon" src="/header_icons/proyectos.webp" alt="" />
				<span>Proyectos</span>
			</a>

			<a class="nav-link" href="#stack">
				<img class="nav-icon" src="/header_icons/tecnologias.webp" alt="" />
				<span>Tecnologías</span>
			</a>

			<a class="nav-link" href="#sobre-mi">
				<img class="nav-icon" src="/header_icons/sobre_mi.webp" alt="" />
				<span>Sobre mí</span>
			</a>

			<a class="nav-link" href="#contacto">
				<img class="nav-icon" src="/header_icons/contacto.webp" alt="" />
				<span>Contacto</span>
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	const setActiveLink = (hash: string) => {
		navLinks.forEach((link) => {
			const isActive = link.hash === hash;
			link.classList.toggle("is-active", isActive);

			if (isActive) {
				link.setAttribute("aria-current", "page");
			} else {
				link.removeAttribute("aria-current");
			}
		});
	};

	const getHeaderHeight = () => header?.getBoundingClientRect().height ?? 0;

	const updateHeaderOffset = () => {
		document.documentElement.style.setProperty("--sticky-header-height", `${getHeaderHeight()}px`);
	};

	const updateActiveLinkFromScroll = () => {
		const scrollMarker = window.scrollY + getHeaderHeight() + 16;
		let activeHash = "#inicio";

		navLinks.forEach((link) => {
			const target = document.querySelector<HTMLElement>(link.hash);

			if (target && window.scrollY + target.getBoundingClientRect().top <= scrollMarker) {
				activeHash = link.hash;
			}
		});

		setActiveLink(activeHash);
	};

	const scrollToHash = (hash: string) => {
		if (hash === "#inicio") {
			window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
			return;
		}

		const target = document.querySelector<HTMLElement>(hash);

		if (!target) return;

		window.scrollTo({
			top: Math.max(0, window.scrollY + target.getBoundingClientRect().top - getHeaderHeight() - 3),
			behavior: reducedMotion.matches ? "auto" : "smooth",
		});
	};

	if (header) {
		updateHeaderOffset();
		new ResizeObserver(() => {
			updateHeaderOffset();
			updateActiveLinkFromScroll();
		}).observe(header);
	}

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
		link.addEventListener("click", (event) => {
			const hash = link.hash;

			if (!hash) return;

			event.preventDefault();
			setActiveLink(hash);
			scrollToHash(hash);
			history.pushState(null, "", hash);
		});
	});

	if (window.location.hash) {
		setActiveLink(window.location.hash);
	}

	window.addEventListener("hashchange", () => {
		if (window.location.hash) {
			setActiveLink(window.location.hash);
		}
	});

	let scrollAnimationFrame: number | undefined;
	window.addEventListener(
		"scroll",
		() => {
			if (scrollAnimationFrame) return;

			scrollAnimationFrame = window.requestAnimationFrame(() => {
				updateActiveLinkFromScroll();
				scrollAnimationFrame = undefined;
			});
		},
		{ passive: true },
	);

	updateActiveLinkFromScroll();
</script>

<style>
	.site-header {
		--forest: #0d4038;
		--ink: #181912;
		--paper: #e9d9b9;
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		border: 3px ridge #b8a27d;
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 7%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 9%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 25px rgb(82 55 21 / 15%);
		color: var(--ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 32.4px;
		padding: 2.7px 7px 2.7px 10px;
		border-bottom: 3px ridge #b8a27d;
		background: var(--forest);
		box-shadow: inset 0 1px #2a675c, inset 0 -1px #06251f;
	}

	.window-bar > img {
		width: 23.4px;
		height: 23.4px;
		object-fit: contain;
		image-rendering: pixelated;
	}

	.window-controls {
		display: flex;
		gap: 5px;
	}

	.window-control {
		position: relative;
		display: block;
		width: 24.3px;
		height: 24.3px;
		border: 3px outset #d8c69f;
		background: #d5c39e;
		box-shadow: 1px 1px 0 #0a1915;
	}

	.window-control::before,
	.window-control::after {
		position: absolute;
		content: "";
		background: #17201b;
	}

	.window-control--minimize::before {
		left: 6px;
		right: 6px;
		bottom: 5px;
		height: 2px;
	}

	.window-control--maximize::before {
		inset: 4px;
		border: 2px solid #17201b;
		background: transparent;
	}

	.window-control--close::before,
	.window-control--close::after {
		top: 50%;
		left: 50%;
		width: 60%;
		height: 2px;
		transform-origin: center;
	}

	.window-control--close::before { transform: translate(-50%, -50%) rotate(45deg); }
	.window-control--close::after { transform: translate(-50%, -50%) rotate(-45deg); }

	.header-content {
		display: flex;
		min-height: 103.68px;
		align-items: center;
		justify-content: space-between;
		gap: clamp(24px, 5vw, 80px);
		padding: 8.91px clamp(22px, 4vw, 72px);
		border-bottom: 2px solid rgb(63 56 39 / 65%);
	}

	.brand {
		display: flex;
		min-width: max-content;
		align-items: center;
		gap: 18px;
		color: inherit;
		text-decoration: none;
	}

	.brand-icon {
		width: 87.48px;
		height: 87.48px;
		object-fit: contain;
		image-rendering: pixelated;
		filter: drop-shadow(3px 3px 0 rgb(49 41 24 / 35%));
	}

	.brand-copy { padding-top: 3px; }

	.brand-name {
		margin: 0;
		color: var(--forest);
		font-size: clamp(2rem, 2.8vw, 3.8rem);
		font-weight: 800;
		letter-spacing: 0.025em;
		line-height: 0.95;
		text-shadow: 2px 2px 0 rgb(23 53 45 / 12%);
	}

	.brand-name-accent { color: #7a301f; }

	.brand-tagline {
		margin: 0px 0 0;
		font-size: clamp(0.95rem, 1.3vw, 1.35rem);
		font-weight: 600;
		letter-spacing: 0.015em;
	}

	.brand-tagline span {
		color: #3f6d27;
		font-family: system-ui, sans-serif;
	}

	.main-nav {
		display: flex;
		align-items: stretch;
		justify-content: flex-end;
		gap: clamp(8px, 1.5vw, 30px);
	}

	.nav-link {
		display: inline-flex;
		min-height: 43.74px;
		align-items: center;
		gap: 11px;
		padding: 7.29px 13px;
		border: 2px solid transparent;
		color: #171914;
		font-size: clamp(1.05rem, 1.35vw, 1.5rem);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: color 120ms ease, transform 120ms ease;
	}

	.nav-link:hover {
		color: #7a301f;
		transform: translateY(-2px);
	}

	.nav-link:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 3px;
	}

	.nav-link.is-active {
		border-color: #c4b18e;
		border-style: outset;
		background: rgb(199 184 153 / 55%);
		box-shadow: inset 0 0 12px rgb(67 52 29 / 9%);
	}

	.nav-icon {
		width: 27px;
		height: 27px;
		flex: 0 0 auto;
		object-fit: contain;
		image-rendering: pixelated;
		filter: drop-shadow(1px 1px 0 rgb(255 255 255 / 70%));
	}

	@media (min-width: 1181px) and (max-height: 820px) {
		.window-bar {
			height: 29px;
			padding-block: 2px;
		}

		.window-bar > img {
			width: 21px;
			height: 21px;
		}

		.window-control {
			width: 24px;
			height: 24px;
		}

		.header-content {
			min-height: 84px;
			gap: clamp(20px, 4vw, 64px);
			padding: 6px clamp(20px, 3.5vw, 60px);
		}

		.brand {
			gap: 14px;
		}

		.brand-icon {
			width: 70px;
			height: 70px;
		}

		.brand-name {
			font-size: clamp(1.9rem, 2.35vw, 3rem);
		}

		.brand-tagline {
			font-size: clamp(0.85rem, 1.05vw, 1.05rem);
		}

		.main-nav {
			gap: clamp(6px, 1vw, 18px);
		}

		.nav-link {
			min-height: 38px;
			gap: 8px;
			padding: 6px 10px;
			font-size: clamp(1rem, 1.08vw, 1.2rem);
		}

		.nav-icon {
			width: 23px;
			height: 23px;
		}
	}

	@media (max-width: 1180px) {
		.header-content {
			flex-direction: column;
			gap: 6.48px;
			padding-block: 11.34px 14.58px;
		}

		.main-nav {
			width: 100%;
			justify-content: center;
		}
	}

	@media (max-width: 700px) {
		.window-bar { height: 27.9px; }
		.window-control { width: 20.7px; height: 20.7px; }

		.header-content {
			align-items: flex-start;
			padding: 11.34px 14px 9.72px;
		}

		.brand { gap: 10px; }
		.brand-icon { width: 63.18px; height: 63.18px; }
		.brand-name { font-size: clamp(1.55rem, 7.7vw, 2.4rem); }
		.brand-tagline { margin-top: 5.67px; font-size: clamp(0.78rem, 3.5vw, 1rem); }

		.main-nav {
			justify-content: flex-start;
			overflow-x: auto;
			padding: 5.67px 0 4.05px;
			scrollbar-color: var(--forest) #cdbc9c;
			scrollbar-width: thin;
		}

		.nav-link {
			min-height: 37.26px;
			gap: 7px;
			padding: 5.67px 9px;
			font-size: 1rem;
		}

		.nav-icon { width: 23px; height: 23px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-link { transition: none; }
	}
</style>
