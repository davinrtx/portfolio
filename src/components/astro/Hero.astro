---
import "@fontsource-variable/pixelify-sans";
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-art" aria-hidden="true">
		<div class="hero-windows">
			<img
				class="hero-window hero-window--notes"
				src="/images/notas_txt.webp"
				alt=""
				width="1174"
				height="795"
			/>
			<img
				class="hero-window hero-window--landscape"
				src="/images/paisaje.webp"
				alt=""
				width="1359"
				height="1013"
			/>
		</div>

		<img
			class="hero-scene"
			src="/images/escritorio_hero.webp"
			alt=""
			width="1665"
			height="899"
			fetchpriority="high"
		/>
	</div>

	<img
		class="hero-plants"
		src="/images/plantas_hero.webp"
		alt=""
		width="495"
		height="2145"
		aria-hidden="true"
	/>

	<div class="hero-copy">
		<h1 id="hero-title">Hola, Soy Damian</h1>
		<p class="hero-role">Ingeniero en Sistemas Computacionales</p>
		<p class="hero-description">
			Apasionado por escribir código y transformar la lógica en experiencias interactivas modernas.
			Disfruto desarrollar soluciones web y móviles escalables dentro del ecosistema de JavaScript,
			manteniendo siempre una curiosidad constante por seguir aprendiendo.
		</p>
	</div>

	<div class="hero-actions" role="group" aria-label="Acciones principales">
		<a class="hero-button hero-button--primary" href="#proyectos">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 5v14l11-7z" />
			</svg>
			<span>Ver proyectos</span>
		</a>

		<a class="hero-button" href="#contacto">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M3 5.5h18v13H3zM4 7l8 6 8-6M4 18l5.5-6M20 18l-5.5-6" />
			</svg>
			<span>Contactar</span>
		</a>

		<button class="hero-button hero-button--cv" type="button" title="CV próximamente">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 2.5h8l4 4v15H6zM14 2.5v4h4M9 12h6M9 16h6" />
			</svg>
			<span>CV</span>
		</button>
	</div>

	<!-- La ventana de código se añadirá aquí cuando esté disponible su imagen. -->
</section>

<style>
	.hero {
		--forest: #16483c;
		--ink: #171914;
		--paper: #eadabd;
		position: relative;
		isolation: isolate;
		z-index: 1;
		width: 100%;
		height: calc(100svh - var(--sticky-header-height, 144px));
		min-height: 540px;
		overflow: hidden;
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 16%);
		color: var(--ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.hero::after {
		position: absolute;
		z-index: 4;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		background: rgb(49 40 25 / 48%);
		content: "";
	}

	.hero-art {
		position: absolute;
		z-index: 1;
		right: 0;
		bottom: 0;
		left: auto;
		height: min(100%, 59.389vw);
		aspect-ratio: 1665 / 899;
		transform: none;
		pointer-events: none;
		user-select: none;
	}

	.hero-scene {
		position: absolute;
		z-index: 2;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		filter: drop-shadow(-3px 2px 3px rgb(31 43 18 / 30%));
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 100%);
		mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 100%);
	}

	.hero-windows {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
	}

	.hero-window {
		position: absolute;
		display: block;
		height: auto;
		filter: drop-shadow(4px 5px 2px rgb(45 34 18 / 28%));
		user-select: none;
	}

	.hero-window--notes {
		top: 2%;
		right: 20%;
		width: 15.25%;
	}

	.hero-window--landscape {
		top: 38.5%;
		left: 28.5%;
		width: 22.25%;
	}

	.hero-plants {
		position: absolute;
		z-index: 2;
		bottom: 0;
		left: 0;
		display: block;
		width: auto;
		height: 100%;
		filter: drop-shadow(3px 2px 2px rgb(31 43 18 / 22%));
		image-rendering: pixelated;
		pointer-events: none;
		user-select: none;
	}

	.hero-copy {
		position: absolute;
		z-index: 3;
		top: 10%;
		left: 6%;
		width: 49%;
		text-shadow: 2px 2px 0 rgb(23 53 45 / 10%);
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(3.6rem, 5.45vw, 6.05rem);
		font-weight: 750;
		letter-spacing: 0.012em;
		line-height: 0.95;
	}

	.hero-role {
		margin: clamp(16px, 2vw, 30px) 0 0;
		color: var(--forest);
		font-size: clamp(1.55rem, 2.45vw, 2.65rem);
		font-weight: 650;
		letter-spacing: 0.01em;
		line-height: 1.04;
	}

	.hero-description {
		max-width: 700px;
		margin: clamp(22px, 2.1vw, 32px) 0 0;
		padding-top: clamp(18px, 1.5vw, 24px);
		border-top: 2px dotted rgb(56 50 35 / 45%);
		color: #000;
		font-family: Consolas, "Courier New", monospace;
		font-size: clamp(0.85rem, 0.95vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.01em;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.hero-actions {
		position: absolute;
		z-index: 3;
		top: 59.5%;
		left: 6%;
		display: flex;
		align-items: stretch;
		gap: clamp(12px, 1.7vw, 27px);
	}

	.hero-button {
		display: inline-flex;
		min-width: clamp(150px, 13.8vw, 215px);
		height: clamp(52px, 4.35vw, 68px);
		align-items: center;
		justify-content: center;
		gap: 13px;
		padding: 8px clamp(18px, 1.7vw, 29px);
		border: 3px outset #c9b998;
		background: rgb(224 210 183 / 92%);
		box-shadow: 3px 4px 0 rgb(45 39 26 / 35%), inset 0 0 13px rgb(94 72 39 / 8%);
		color: var(--ink);
		font: inherit;
		font-size: clamp(1.15rem, 1.5vw, 1.6rem);
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: filter 120ms ease, transform 120ms ease, box-shadow 120ms ease;
	}

	.hero-button--primary {
		border-color: #668675;
		background: #174b3e;
		box-shadow: 3px 4px 0 rgb(35 39 28 / 46%), inset 0 0 0 2px #9daf93;
		color: #f0e8d6;
	}

	.hero-button--cv {
		min-width: clamp(92px, 8vw, 125px);
	}

	.hero-button svg {
		width: 25px;
		height: 25px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1.8;
	}

	.hero-button--primary svg {
		fill: currentColor;
		stroke: none;
	}

	.hero-button:hover {
		filter: brightness(1.06);
		transform: translateY(-2px);
		box-shadow: 3px 6px 0 rgb(45 39 26 / 32%), inset 0 0 13px rgb(94 72 39 / 8%);
	}

	.hero-button--primary:hover {
		box-shadow: 3px 6px 0 rgb(35 39 28 / 40%), inset 0 0 0 2px #9daf93;
	}

	.hero-button:active {
		border-style: inset;
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 rgb(45 39 26 / 30%);
	}

	.hero-button:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 5px;
	}

	@media (max-width: 1180px) {
		.hero {
			height: calc(100svh - var(--sticky-header-height, 202px));
			min-height: 520px;
		}

		.hero-copy {
			top: 9%;
			width: 52%;
		}

		.hero-copy h1 {
			font-size: clamp(3.4rem, 5.35vw, 4.5rem);
		}

		.hero-role {
			font-size: clamp(1.45rem, 2.35vw, 2rem);
		}

		.hero-description {
			max-width: 58vw;
			font-size: clamp(0.82rem, 1.25vw, 0.95rem);
		}

		.hero-actions {
			gap: 13px;
		}

		.hero-button {
			min-width: 0;
			padding-inline: 18px;
		}
	}

	@media (max-width: 780px) {
		.hero {
			min-height: 700px;
		}

		.hero-art {
			right: auto;
			bottom: 0;
			left: 50%;
			width: 1353px;
			height: auto;
			transform: translateX(-45%);
		}

		.hero-copy {
			top: 8%;
			left: 7%;
			width: 86%;
		}

		.hero-copy h1 {
			font-size: clamp(3rem, 11.7vw, 4.8rem);
		}

		.hero-role {
			max-width: 620px;
			font-size: clamp(1.6rem, 6vw, 2.35rem);
		}

		.hero-description {
			display: none;
		}

		.hero-window--notes {
			display: none;
		}

		.hero-actions {
			top: 35%;
			left: 7%;
			max-width: 86%;
			flex-wrap: wrap;
		}

		.hero-button {
			height: 52px;
			font-size: 1.1rem;
		}
	}

	@media (max-width: 480px) {
		.hero {
			min-height: 760px;
		}

		.hero-copy h1 {
			font-size: clamp(2.75rem, 13vw, 3.7rem);
		}

		.hero-role {
			font-size: clamp(1.35rem, 7vw, 1.9rem);
		}

		.hero-actions {
			top: 34%;
			gap: 10px;
		}

		.hero-button {
			height: 48px;
			gap: 8px;
			padding-inline: 13px;
			font-size: 1rem;
		}

		.hero-button svg {
			width: 20px;
			height: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-button {
			transition: none;
		}
	}
</style>
