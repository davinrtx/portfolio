---
import "@fontsource-variable/pixelify-sans";
import "./StackDisk.css";
import FrameworkCassette from "../react/FrameworkCassette";

type Language = {
	name: string;
	icon?: string;
};

const genericLanguageIcon = "</>";

const languages: Language[] = [
	{ name: "JavaScript" },
	{ name: "TypeScript" },
	{ name: "HTML" },
	{ name: "CSS" },
	{ name: "SQL" },
];
---

<section class="stack" id="stack" aria-labelledby="stack-title">
	<div class="stack-shell">
		<header class="stack-heading">
			<p class="stack-eyebrow">STACK.EXE</p>
			<h2 id="stack-title">Stack</h2>
		</header>

		<div class="stack-cards">
			<article class="language-disk" aria-labelledby="languages-title">
				<div class="disk-label">
					<div class="disk-icon-bay" aria-hidden="true">
						<div class="document-icon">
							<span>&lt;/&gt;</span>
						</div>
					</div>

					<div class="disk-copy">
						<p class="group-number">01 /</p>
						<h3 id="languages-title">Lenguajes</h3>
						<p>La base de todo.<br />Con esto trabajo en mi día a día.</p>
					</div>
				</div>

				<div class="language-tray">
					<ul class="language-grid" aria-label="Lenguajes de programación">
						{
							languages.map((language) => (
								<li class="language-chip">
									<span class="language-icon-slot" aria-hidden="true">
										{
											language.icon ? (
												<img src={language.icon} alt="" loading="lazy" />
											) : (
												genericLanguageIcon
											)
										}
									</span>
									<span>{language.name}</span>
								</li>
							))
						}
					</ul>
				</div>

				<div class="disk-bottom" aria-hidden="true">
					<div class="disk-shutter">
						<span class="shutter-window"></span>
						<span class="disk-capacity">1.44 MB</span>
					</div>

					<div class="disk-lock">
						<span>↓</span>
					</div>
				</div>
			</article>

			<FrameworkCassette client:visible />
		</div>
	</div>
</section>

<style>
	.stack {
		--stack-paper: #eadabd;
		--stack-ink: #171914;
		--stack-forest: #153e34;
		width: 100%;
		padding: clamp(36px, 2vw, 72px) clamp(18px, 5vw, 80px) clamp(82px, 9vw, 136px);
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--stack-paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--stack-ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.stack-shell {
		width: min(100%, 1240px);
		margin-inline: auto;
	}

	.stack-heading {
		display: flex;
		max-width: 900px;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.stack-eyebrow {
		margin: 0;
		color: #6f2f20;
		font-size: clamp(0.95rem, 1.2vw, 1.15rem);
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.stack-heading h2 {
		margin: 0;
		padding-bottom: clamp(17px, 1.8vw, 24px);
		border-bottom: 2px dotted rgb(83 63 10 / 48%);
		font-size: clamp(3rem, 4vw, 5.6rem);
		font-weight: 150;
		letter-spacing: 0.01em;
		line-height: 0.92;
		text-shadow: 3px 3px 0 rgb(23 53 45 / 10%);
		text-wrap: balance;
	}

	.stack-cards {
		display: grid;
		margin-top: clamp(30px, 4vw, 54px);
		align-items: start;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(24px, 3vw, 42px);
	}

	@media (max-width: 1180px) {
		.stack-cards {
			grid-template-columns: minmax(0, 587px);
			justify-content: center;
		}
	}

	@media (max-width: 620px) {
		.stack {
			padding-inline: 12px;
		}
	}

	@media (max-width: 440px) {
		.stack-heading h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}
	}
</style>
