---
import "@fontsource-variable/pixelify-sans";

type Language = {
	name: string;
	icon?: string;
};

const genericLanguageIcon = "</>";

const languages: Language[] = [
	{ name: "JavaScript" },
	{ name: "TypeScript" },
	{ name: "HTML" },
	{ name: "CSS" },
	{ name: "SQL" },
];
---

<section class="stack" id="stack" aria-labelledby="stack-title">
	<div class="stack-shell">
		<header class="stack-heading">
			<p class="stack-eyebrow">STACK.EXE</p>
			<h2 id="stack-title">Stack</h2>
		</header>

		<article class="language-disk" aria-labelledby="languages-title">
			<div class="disk-label">
				<div class="disk-icon-bay" aria-hidden="true">
					<div class="document-icon">
						<span>&lt;/&gt;</span>
					</div>
				</div>

				<div class="disk-copy">
					<p class="group-number">01 / LENGUAJES</p>
					<h3 id="languages-title">Lenguajes</h3>
					<p>La base de todo.<br />Con esto doy vida a las ideas.</p>
				</div>
			</div>

			<div class="language-tray">
				<ul class="language-grid" aria-label="Lenguajes de programación">
					{
						languages.map((language) => (
							<li class="language-chip">
								<span class="language-icon-slot" aria-hidden="true">
									{
										language.icon ? (
											<img src={language.icon} alt="" loading="lazy" />
										) : (
											genericLanguageIcon
										)
									}
								</span>
								<span>{language.name}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="disk-bottom" aria-hidden="true">
				<div class="disk-shutter">
					<span class="shutter-window"></span>
					<span class="disk-capacity">1.44 MB</span>
				</div>

				<div class="disk-lock">
					<span>↓</span>
				</div>
			</div>
		</article>
	</div>
</section>

<style>
	.stack {
		--stack-paper: #eadabd;
		--stack-ink: #171914;
		--stack-forest: #153e34;
		width: 100%;
		padding: clamp(36px, 2vw, 72px) clamp(18px, 5vw, 80px) clamp(82px, 9vw, 136px);
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--stack-paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--stack-ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.stack-shell {
		width: min(100%, 1240px);
		margin-inline: auto;
	}

	.stack-heading {
		display: flex;
		max-width: 900px;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.stack-eyebrow {
		margin: 0;
		color: #6f2f20;
		font-size: clamp(0.95rem, 1.2vw, 1.15rem);
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.stack-heading h2 {
		margin: 0;
		padding-bottom: clamp(17px, 1.8vw, 24px);
		border-bottom: 2px dotted rgb(83 63 10 / 48%);
		font-size: clamp(3rem, 4vw, 5.6rem);
		font-weight: 150;
		letter-spacing: 0.01em;
		line-height: 0.92;
		text-shadow: 3px 3px 0 rgb(23 53 45 / 10%);
		text-wrap: balance;
	}

	.language-disk {
		position: relative;
		width: min(100%, 790px);
		margin: 20px auto 0;
		overflow: hidden;
		padding: clamp(18px, 2.7vw, 28px) clamp(18px, 3.2vw, 34px) 0;
		background-color: var(--stack-forest);
		background-image:
			radial-gradient(circle at 20% 25%, rgb(255 255 255 / 6%) 0 1px, transparent 1.4px),
			radial-gradient(circle at 72% 68%, rgb(0 0 0 / 12%) 0 1px, transparent 1.5px),
			linear-gradient(145deg, rgb(255 255 255 / 6%), transparent 32%, rgb(0 0 0 / 9%));
		background-size: 7px 7px, 9px 9px, 100% 100%;
		box-shadow:
			inset 0 0 0 4px #092820,
			inset 0 0 0 7px #41695c;
		clip-path: polygon(
			17px 0,
			calc(100% - 17px) 0,
			100% 17px,
			100% calc(100% - 17px),
			calc(100% - 17px) 100%,
			17px 100%,
			0 calc(100% - 17px),
			0 17px
		);
		filter: drop-shadow(9px 11px 0 rgb(49 39 23 / 24%));
	}

	.language-disk::after {
		position: absolute;
		inset: 9px;
		border: 1px solid rgb(181 203 181 / 22%);
		content: "";
		pointer-events: none;
	}

	.disk-label {
		display: grid;
		min-height: 218px;
		grid-template-columns: minmax(175px, 0.72fr) minmax(0, 1.65fr);
	}

	.disk-icon-bay {
		display: grid;
		border-right: 3px ridge #41695c;
		place-items: center;
	}

	.document-icon {
		position: relative;
		display: grid;
		width: clamp(104px, 15vw, 126px);
		aspect-ratio: 0.76;
		border: 4px ridge #a99570;
		background-color: #dfcca8;
		background-image: repeating-linear-gradient(
			0deg,
			transparent 0 11px,
			rgb(94 68 34 / 12%) 11px 12px
		);
		box-shadow:
			7px 7px 0 #071b16,
			inset 0 0 14px rgb(83 56 24 / 14%);
		clip-path: polygon(0 0, 72% 0, 100% 21%, 100% 100%, 0 100%);
		place-items: center;
	}

	.document-icon::before {
		position: absolute;
		top: 0;
		right: 0;
		width: 28%;
		aspect-ratio: 1;
		border-bottom: 4px solid #8e7854;
		border-left: 4px solid #8e7854;
		background: #c8b38d;
		content: "";
	}

	.document-icon span {
		padding-top: 20px;
		font-family: Consolas, "Courier New", monospace;
		font-size: clamp(1.7rem, 4vw, 2.55rem);
		font-weight: 800;
		letter-spacing: -0.18em;
	}

	.disk-copy {
		position: relative;
		padding: clamp(24px, 4vw, 38px) clamp(24px, 4.5vw, 46px);
		background-color: #ebdab9;
		background-image:
			radial-gradient(circle at 20% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 16%), transparent 48%, rgb(89 62 30 / 5%));
		background-size: 6px 6px, 100% 100%;
		box-shadow: inset 0 0 22px rgb(82 55 21 / 12%);
		clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%);
	}

	.disk-copy::after {
		position: absolute;
		top: 0;
		right: 0;
		width: 30px;
		height: 30px;
		border-bottom: 3px solid #9f8b65;
		border-left: 3px solid #9f8b65;
		background: #c9b48d;
		content: "";
	}

	.group-number {
		margin: 0 0 2px;
		color: #6f2f20;
		font-size: clamp(0.82rem, 1.3vw, 1rem);
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.disk-copy h3 {
		margin: 0;
		padding-bottom: 8px;
		border-bottom: 3px dotted rgb(50 47 34 / 70%);
		font-size: clamp(2rem, 4.3vw, 3.1rem);
		font-weight: 500;
		line-height: 1;
	}

	.disk-copy > p:last-child {
		margin: 14px 0 0;
		font-family: Consolas, "Courier New", monospace;
		font-size: clamp(0.98rem, 2vw, 1.2rem);
		line-height: 1.45;
	}

	.language-tray {
		position: relative;
		margin-top: clamp(17px, 2.8vw, 25px);
		padding: clamp(14px, 2.5vw, 24px);
		border: 4px ridge #b6a17b;
		background-color: #e0cda9;
		background-image:
			radial-gradient(circle at 22% 30%, rgb(94 66 31 / 8%) 0 1px, transparent 1.3px),
			linear-gradient(90deg, rgb(255 255 255 / 13%), transparent 48%, rgb(70 49 22 / 5%));
		background-size: 6px 6px, 100% 100%;
		box-shadow:
			6px 7px 0 rgb(5 24 19 / 35%),
			inset 0 0 18px rgb(87 60 28 / 11%);
	}

	.language-grid {
		display: grid;
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: clamp(12px, 2vw, 18px);
		list-style: none;
	}

	.language-chip {
		display: flex;
		min-height: 70px;
		align-items: center;
		justify-content: center;
		gap: clamp(9px, 1.5vw, 14px);
		padding: 10px clamp(10px, 1.8vw, 18px);
		border: 3px outset #d8c39c;
		background: #e5d2af;
		box-shadow:
			3px 4px 0 rgb(50 40 24 / 24%),
			inset 0 0 10px rgb(96 72 39 / 8%);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1;
		white-space: nowrap;
	}

	.language-chip:nth-child(-n + 2) {
		grid-column: span 3;
	}

	.language-chip:nth-child(n + 3) {
		grid-column: span 2;
	}

	.language-icon-slot {
		display: grid;
		width: 36px;
		height: 36px;
		flex: 0 0 36px;
		border: 2px outset #7e9d8c;
		background: #24584a;
		box-shadow: 2px 2px 0 rgb(50 40 24 / 25%);
		color: #f0e3c8;
		font-family: Consolas, "Courier New", monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: -0.11em;
		place-items: center;
	}

	.language-icon-slot img {
		display: block;
		width: 24px;
		height: 24px;
		object-fit: contain;
		image-rendering: pixelated;
	}

	.disk-bottom {
		position: relative;
		min-height: clamp(116px, 17vw, 154px);
	}

	.disk-shutter {
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 54%;
		height: 93%;
		border: 4px ridge #9e8d6e;
		border-bottom: 0;
		background-color: #aa9c7d;
		background-image:
			radial-gradient(circle at 25% 20%, rgb(255 255 255 / 11%) 0 1px, transparent 1.4px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 45%, rgb(46 39 28 / 13%));
		background-size: 7px 7px, 100% 100%;
		box-shadow: 5px 0 0 rgb(4 24 19 / 33%);
		transform: translateX(-50%);
	}

	.shutter-window {
		position: absolute;
		top: 16px;
		bottom: 16px;
		left: 14%;
		width: 21%;
		border: 4px inset #817658;
		background: #17463b;
		box-shadow: inset 0 0 12px #08241e;
	}

	.disk-capacity {
		position: absolute;
		right: 10px;
		bottom: 8px;
		font-size: clamp(0.8rem, 1.6vw, 1rem);
	}

	.disk-lock {
		position: absolute;
		right: 2%;
		bottom: 0;
		display: grid;
		width: 12%;
		height: 76%;
		border: 3px ridge #0a2d26;
		background: #17463b;
		box-shadow: inset 0 0 16px rgb(3 23 18 / 35%);
		place-items: end center;
	}

	.disk-lock span {
		margin-bottom: 14px;
		color: #dbcba9;
		font-family: Consolas, "Courier New", monospace;
		font-size: clamp(1.45rem, 3vw, 2rem);
		line-height: 1;
		text-shadow: 2px 2px 0 #08231d;
	}

	@media (max-width: 620px) {
		.stack {
			padding-inline: 12px;
		}

		.language-disk {
			padding-inline: 15px;
		}

		.disk-label {
			min-height: 190px;
			grid-template-columns: 36% minmax(0, 1fr);
		}

		.disk-icon-bay {
			padding-right: 13px;
		}

		.document-icon {
			width: min(100%, 104px);
		}

		.disk-copy {
			padding: 24px 18px;
		}

		.group-number {
			letter-spacing: 0.06em;
		}

		.disk-copy > p:last-child {
			font-size: 0.9rem;
		}

		.language-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.language-chip,
		.language-chip:nth-child(-n + 2),
		.language-chip:nth-child(n + 3) {
			grid-column: span 1;
		}

		.language-chip:last-child {
			width: calc(50% - 6px);
			justify-self: center;
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 440px) {
		.stack-heading h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}

		.language-disk {
			padding: 15px 12px 0;
		}

		.disk-label {
			min-height: 0;
			grid-template-columns: 1fr;
		}

		.disk-icon-bay {
			min-height: 140px;
			padding: 10px;
			border-right: 0;
			border-bottom: 3px ridge #41695c;
		}

		.document-icon {
			width: 82px;
		}

		.document-icon span {
			padding-top: 13px;
			font-size: 1.45rem;
		}

		.disk-copy {
			padding: 22px 18px 24px;
		}

		.disk-copy h3 {
			font-size: 2.15rem;
		}

		.language-grid {
			grid-template-columns: 1fr;
		}

		.language-chip,
		.language-chip:nth-child(-n + 2),
		.language-chip:nth-child(n + 3),
		.language-chip:last-child {
			width: 100%;
			grid-column: span 1;
		}

		.disk-bottom {
			min-height: 104px;
		}

		.disk-shutter {
			width: 62%;
		}
	}
</style>
