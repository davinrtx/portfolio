---
import "@fontsource-variable/pixelify-sans";
import ProjectsGallery from "../react/ProjectsGallery";
---

<section class="projects" id="proyectos" aria-labelledby="projects-title">
	<div class="projects-shell">
		<header class="projects-heading">
			<p class="projects-eyebrow">PORTFOLIO.EXE</p>
			<h2 id="projects-title">Proyectos</h2>
				
		</header>

		<ProjectsGallery client:visible />
	</div>
</section>

<style>
	.projects {
		--projects-paper: #eadabd;
		--projects-ink: #171914;
		width: 100%;
		padding: clamp(36px, 2vw, 72px) clamp(18px, 5vw, 80px) clamp(76px, 8vw, 120px);
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		background-color: var(--projects-paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 8%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 10%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--projects-ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.projects-shell {
		width: min(100%, 1240px);
		margin-inline: auto;
	}

	.projects-heading {
		display: flex;
		max-width: 900px;
		margin-inline: auto;
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	.projects-eyebrow {
		margin: 0 0 0px;
		color: #6f2f20;
		font-size: clamp(0.95rem, 1.2vw, 1.15rem);
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.projects-heading h2 {
		margin: 0;
		font-size: clamp(3rem, 4vw, 5.6rem);
		font-weight: 150;
		letter-spacing: 0.01em;
		line-height: 0.92;
		text-wrap: balance;
		text-shadow: 3px 3px 0 rgb(23 53 45 / 10%);
		padding-bottom: clamp(17px, 1.8vw, 24px);
		border-bottom: 2px dotted rgba(83, 63, 10, 0.48);
	}

	

	@media (max-width: 560px) {
		.projects {
			padding-inline: 12px;
		}

		.projects-heading h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}
	}
</style>
