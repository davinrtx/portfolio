---
import styles from "./ToolsCabinet.module.css";

// Componente interno reutilizado por la sección de tecnologías.
interface Tool {
	name: string;
	icon?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const genericToolIcon = "◆";
const tools: Tool[] = [
	{ name: "Git", icon: `${base}stack_icons/git.svg` },
	{ name: "GitHub", icon: `${base}stack_icons/github.svg` },
	{ name: "VS Code", icon: `${base}stack_icons/vscode.svg` },
	{ name: "Codex", icon: `${base}stack_icons/codex.svg` },
	{ name: "NPM", icon: `${base}stack_icons/npm.svg` },
	{ name: "Vercel", icon: `${base}stack_icons/vercel.svg` },
	{ name: "Netlify", icon: `${base}stack_icons/netlify.svg` },
	{ name: "Supabase", icon: `${base}stack_icons/supabase.svg` },
	{ name: "Docker", icon: `${base}stack_icons/docker.svg` },
	{ name: "Postman", icon: `${base}stack_icons/postman.svg` },
	{ name: "Insomnia", icon: `${base}stack_icons/insomnia.svg` },
	{ name: "Claude", icon: `${base}stack_icons/claude.svg` },
	{ name: "n8n", icon: `${base}stack_icons/n8n.svg` },
	{ name: "Hermes Agent", icon: `${base}stack_icons/hermes-agent.png` },
];
---

<article class={styles.cabinet} aria-labelledby="tools-title" data-tools-cabinet>
	<header class={styles.cabinetCrown}>
		<div class={styles.crownCap} aria-hidden="true"></div>

		<div class={styles.crownFace}>
			<span class={styles.crownScrew} aria-hidden="true"></span>
			<span class={styles.crownOrnament} aria-hidden="true">◆</span>

			<div class={styles.crownTitle}>
				<span class={styles.crownIcon} aria-hidden="true">⌘</span>
				<p>03 /</p>
				<h3 id="tools-title">Herramientas</h3>
			</div>

			<span class:list={[styles.crownOrnament, styles.crownOrnamentRight]} aria-hidden="true">
				◆
			</span>
			<span class={styles.crownScrew} aria-hidden="true"></span>
		</div>
	</header>

	<div class={styles.pegboard}>
		<ul class={styles.toolGrid} aria-label="Herramientas de desarrollo">
			{
				tools.map((tool) => (
					<li class={styles.toolCard} data-tool-card>
						<span class={styles.pegHook} aria-hidden="true"></span>
						<div class={styles.toolLabel}>
							<span class={styles.toolIcon} aria-hidden="true">
								{tool.icon ? (
									<img src={tool.icon} alt="" loading="lazy" decoding="async" />
								) : (
									genericToolIcon
								)}
							</span>
							<span class={styles.toolName}>{tool.name}</span>
						</div>
					</li>
				))
			}
		</ul>
	</div>

	<footer class={styles.cabinetShelf} aria-hidden="true">
		<div class={styles.shelfLip}>
			<span></span><span></span><span></span>
		</div>

		<div class={styles.drawer}>
			<span class={styles.drawerHandle}></span>
			<p>Mis aliadas del día a día</p>
			<span class={styles.drawerMark}>■</span>
		</div>
	</footer>
</article>

<script>
	const toolMotionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

	document.querySelectorAll<HTMLElement>("[data-tools-cabinet]").forEach((cabinet) => {
		if (cabinet.dataset.cabinetReady === "true") return;
		cabinet.dataset.cabinetReady = "true";

		cabinet.querySelectorAll<HTMLElement>("[data-tool-card]").forEach((card) => {
			card.addEventListener("pointerenter", () => {
				if (toolMotionPreference.matches) return;
				if (!card.hasAttribute("data-swinging")) card.setAttribute("data-swinging", "");
			});

			card.addEventListener("animationend", (event) => {
				if (event.target === card) card.removeAttribute("data-swinging");
			});
		});
	});
</script>
