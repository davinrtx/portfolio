---
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import Hero from "../components/astro/Hero.astro";
import Projects from "../components/astro/Projects.astro";
import Stack from "../components/astro/Stack.astro";
import About from "../components/astro/About.astro";
import Contact from "../components/astro/Contact.astro";
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/windows.webp" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio de Damian Aceves, desarrollador de software." />
		<title>Damian Aceves | Portfolio</title>
	</head>
	<body>
		<Header />
		<main id="inicio">
			<Hero />
			<Projects />
			<Stack />
			<About />
			<Contact />
		</main>
		<Footer />
	</body>
</html>
