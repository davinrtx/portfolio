---
import "@fontsource-variable/pixelify-sans";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
	title="404 | Pagina no encontrada"
	description="La pagina que buscas no existe o fue movida. Vuelve al inicio del portfolio de Ricardo Gonzalez."
>
	<Header />
	<main class="notfound" id="inicio">
		<section class="error-window" aria-labelledby="error-title">
			<div class="window-bar" aria-hidden="true">
				<span class="window-title">
					ERROR<span class="window-title-accent">.EXE</span>
				</span>
				<div class="window-controls">
					<span class="window-control window-control--minimize"></span>
					<span class="window-control window-control--maximize"></span>
					<span class="window-control window-control--close"></span>
				</div>
			</div>

			<div class="error-body">
				<p class="error-code" aria-hidden="true">404</p>
				<h1 id="error-title">Pagina no encontrada</h1>
				<p class="error-text">
					El archivo que buscas no existe, o fue movido a otra carpeta del disco.
				</p>

				<a class="error-home" href={base}>
					<span class="error-home-icon" aria-hidden="true">⏎</span>
					Volver al inicio
				</a>
			</div>
		</section>
	</main>
	<Footer homeHref={base} />
</Layout>

<style>
	.notfound {
		--paper: #e9d9b9;
		--ink: #171914;
		--forest: #0d4038;
		min-height: 70vh;
		display: grid;
		place-items: center;
		padding: clamp(48px, 8vw, 96px) clamp(18px, 5vw, 80px);
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 15% 30%, rgb(96 72 39 / 7%) 0 1px, transparent 1.5px),
			radial-gradient(circle at 75% 70%, rgb(255 255 255 / 18%) 0 1px, transparent 1.5px),
			linear-gradient(90deg, rgb(255 255 255 / 9%), transparent 35%, rgb(89 62 30 / 5%));
		background-size: 5px 5px, 7px 7px, 100% 100%;
		border-inline: 3px ridge #b8a27d;
		border-bottom: 3px ridge #b8a27d;
		box-shadow: inset 0 0 45px rgb(82 55 21 / 14%);
		color: var(--ink);
		font-family: "Pixelify Sans Variable", monospace;
	}

	.error-window {
		width: min(100%, 640px);
		border: 3px ridge #b8a27d;
		background-color: var(--paper);
		box-shadow:
			inset 0 0 30px rgb(82 55 21 / 12%),
			6px 6px 0 rgb(10 25 21 / 55%);
	}

	.window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 7px 9px 7px 14px;
		border-bottom: 3px ridge #b8a27d;
		background: linear-gradient(90deg, #0d4038, #124f48 55%, #0b3834);
		box-shadow: inset 0 1px #2a675c, inset 0 -1px #06251f;
	}

	.window-title {
		color: #f2e8d1;
		font-size: clamp(1.35rem, 2.4vw, 1.8rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		text-shadow: 2px 2px 0 rgb(0 0 0 / 35%);
	}

	.window-title-accent {
		color: #d98d6a;
	}

	.window-controls {
		display: flex;
		gap: 5px;
	}

	.window-control {
		position: relative;
		display: block;
		width: 26px;
		height: 26px;
		border: 3px outset #d8c69f;
		background: #d5c39e;
		box-shadow: 1px 1px 0 #0a1915;
	}

	.window-control::before,
	.window-control::after {
		position: absolute;
		content: "";
		background: #17201b;
	}

	.window-control--minimize::before {
		left: 6px;
		right: 6px;
		bottom: 5px;
		height: 2px;
	}

	.window-control--maximize::before {
		inset: 4px;
		border: 2px solid #17201b;
		background: transparent;
	}

	.window-control--close::before,
	.window-control--close::after {
		top: 50%;
		left: 50%;
		width: 60%;
		height: 2px;
		transform-origin: center;
	}

	.window-control--close::before { transform: translate(-50%, -50%) rotate(45deg); }
	.window-control--close::after { transform: translate(-50%, -50%) rotate(-45deg); }

	.error-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding: clamp(28px, 5vw, 48px) clamp(24px, 6vw, 56px) clamp(32px, 5vw, 52px);
		text-align: center;
	}

	.error-code {
		margin: 0;
		color: #7a301f;
		font-size: clamp(6rem, 18vw, 10rem);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-shadow: 4px 4px 0 rgb(23 53 45 / 12%);
	}

	.error-code::after {
		content: "▌";
		margin-left: 4px;
		color: #0d4038;
		animation: error-blink 1.1s steps(1) infinite;
	}

	.error-body h1 {
		margin: 0;
		color: var(--forest);
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		line-height: 1;
		text-wrap: balance;
	}

	.error-text {
		max-width: 46ch;
		margin: 0;
		font-size: clamp(1.15rem, 2.4vw, 1.5rem);
		line-height: 1.35;
	}

	.error-home {
		display: inline-flex;
		min-height: 46px;
		margin-top: 10px;
		align-items: center;
		gap: 10px;
		padding: 6px 18px 6px 12px;
		border: 4px outset #dbc79f;
		background: #d6c19a;
		box-shadow: 2px 2px 0 rgb(3 21 17 / 75%);
		color: #181911;
		font-size: clamp(1.2rem, 2.4vw, 1.5rem);
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		text-shadow: 1px 1px 0 rgb(255 255 255 / 45%);
	}

	.error-home:hover {
		background: #e1cda5;
	}

	.error-home:active {
		border-style: inset;
		box-shadow: none;
		transform: translate(1px, 1px);
	}

	.error-home:focus-visible {
		outline: 3px dashed #7a301f;
		outline-offset: 4px;
	}

	.error-home-icon {
		color: #7a301f;
		font-size: 1.2em;
		line-height: 1;
	}

	@keyframes error-blink {
		50% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.error-code::after {
			animation: none;
			opacity: 1;
		}
	}
</style>
